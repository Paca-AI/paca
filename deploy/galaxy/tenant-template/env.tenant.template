# =============================================================================
# Per-tenant Galaxy env for Galaxy-Paca (ADR-038 T7 — instance-per-tenant)
# Generated by deploy/galaxy/tenant-template/provision-tenant-paca.sh, which
# replaces every placeholder token (tenant code, domain, fresh secrets) at
# provision time. NEVER commit a generated .env.tenant (contains secrets).
# =============================================================================

ENVIRONMENT=production
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# -- Project-name-driven isolation: every named volume/network/container of
#    this stack is prefixed paca-__TENANT___… . Keep in sync with the -p flag.
COMPOSE_PROJECT_NAME=paca-__TENANT__

# -- Pinned images — upgrade deliberately, all five tags together
#    (see deploy/galaxy/README.md).
PACA_API_IMAGE=pacaai/paca-api:0.9.7
PACA_WEB_IMAGE=pacaai/paca-web:0.9.7
PACA_REALTIME_IMAGE=pacaai/paca-realtime:0.9.7
PACA_AI_AGENT_IMAGE=pacaai/paca-ai-agent:0.9.7
AGENT_SERVER_IMAGE=ghcr.io/paca-ai/paca-agent-server:0.9.7

# -- Public origin (TLS at the Cloudflare edge; Caddy serves plain HTTP)
PUBLIC_URL=https://__DOMAIN__
CORS_ORIGINS=https://__DOMAIN__
STORAGE_PUBLIC_URL=https://__DOMAIN__/storage
SITE_ADDRESS=:80
COOKIE_SECURE=true

# -- galaxy_network DNS name of this tenant's gateway. The Cloudflare tunnel
#    ingress for https://__DOMAIN__ must point at http://paca-__TENANT__-gateway:80.
GATEWAY_NETWORK_ALIAS=paca-__TENANT__-gateway

# -- Database (volume paca-__TENANT___postgres_data)
POSTGRES_DB=paca
POSTGRES_USER=paca
POSTGRES_PASSWORD=__POSTGRES_PASSWORD__

# -- Auth
JWT_SECRET=__JWT_SECRET__
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__ADMIN_PASSWORD__

# -- Encryption at rest (plugin secrets + agent LLM keys) — 64 hex chars
ENCRYPTION_KEY=__ENCRYPTION_KEY__

# -- Object storage (bundled MinIO)
STORAGE_ACCESS_KEY_ID=paca-minio
STORAGE_SECRET_ACCESS_KEY=__STORAGE_SECRET_ACCESS_KEY__

# -- ai-agent pre-shared keys. The service stays scaled to 0, but these MUST
#    be non-empty anyway: an empty key would leave the API/agent endpoints
#    fail-open the day the service is enabled.
AGENT_API_KEY=__AGENT_API_KEY__
INTERNAL_API_KEY=__INTERNAL_API_KEY__

# =============================================================================
# ADR-038 P1 — Vortex identity
# =============================================================================

# -- OIDC SSO login (Vortex). Register client id paca-__TENANT__ on the
#    identity portal, then paste the issued secret below. Redirect URL:
#    https://__DOMAIN__/api/v1/auth/oidc/callback
OIDC_ISSUER=https://ai.skyplatform.net/api/identity
OIDC_CLIENT_ID=paca-__TENANT__
OIDC_CLIENT_SECRET=__FILL_ME_FROM_VORTEX__
#OIDC_SCOPES=openid profile email
#OIDC_AUTO_CREATE_USERS=true
#OIDC_DEFAULT_ROLE=USER
#OIDC_BUTTON_LABEL=Sign in with Vortex

# -- Trusted-issuer bearer auth (agents act as users via act_as claims).
GALAXY_TRUSTED_ISSUER=https://ai.skyplatform.net/api/identity

# -- Legacy X-Agent-ID header impersonation stays DISABLED (ADR-038).
#AGENT_HEADER_IMPERSONATION=disabled

# -- Force ALL ai-agent LLM traffic through the platform proxy.
LLM_BASE_URL_OVERRIDE=https://ai.skyplatform.net/api/identity/ai/v1
#LLM_API_KEY_OVERRIDE=

# =============================================================================
# ADR-038 P3.2 — Galaxy chat dock
# =============================================================================

# -- Advertised on GET /api/v1/auth/config; empty keeps the dock unmounted.
GALAXY_DOCK_SRC=https://ai.skyplatform.net/dock.js
#GALAXY_GATEWAY_URL=http://vortex-gateway

# =============================================================================
# ADR-038 P3.1 — notify-bridge (Paca events → Galaxy notification inbox)
# =============================================================================

BRIDGE_ENABLED=false
#GALAXY_NOTIFY_REDIS_URL=redis://agentops-redis:6379/0
#NOTIFY_FANOUT_CHANNEL=notify.fan-out

# -- Backups (host HDD; per-tenant directory)
BACKUP_DIR=/backup/paca-__TENANT__-postgres
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 2 * * *
