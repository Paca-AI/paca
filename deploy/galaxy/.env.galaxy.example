# =============================================================================
# Galaxy production env for Galaxy-Paca
# Copy to deploy/galaxy/.env.galaxy on the prod host and fill every __FILL_ME__.
# NEVER commit the real .env.galaxy (gitignored).
# Generate secrets with: openssl rand -hex 32   (ENCRYPTION_KEY MUST be 64 hex)
# =============================================================================

ENVIRONMENT=production
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# -- Pinned images — upgrade deliberately: read upstream release notes, then
#    bump all five tags together (see deploy/galaxy/README.md).
PACA_API_IMAGE=pacaai/paca-api:0.9.7
PACA_WEB_IMAGE=pacaai/paca-web:0.9.7
PACA_REALTIME_IMAGE=pacaai/paca-realtime:0.9.7
PACA_AI_AGENT_IMAGE=pacaai/paca-ai-agent:0.9.7
AGENT_SERVER_IMAGE=ghcr.io/paca-ai/paca-agent-server:0.9.7

# -- Public origin (TLS at the Cloudflare edge; Caddy serves plain HTTP)
PUBLIC_URL=https://tasks.skyplatform.net
CORS_ORIGINS=https://tasks.skyplatform.net
STORAGE_PUBLIC_URL=https://tasks.skyplatform.net/storage
SITE_ADDRESS=:80
COOKIE_SECURE=true
# galaxy_network DNS name of this gateway (Cloudflare tunnel target). Only
# per-tenant instances change it — see deploy/galaxy/tenant-template/.
#GATEWAY_NETWORK_ALIAS=paca-gateway

# -- Database
POSTGRES_DB=paca
POSTGRES_USER=paca
POSTGRES_PASSWORD=__FILL_ME__

# -- Auth
JWT_SECRET=__FILL_ME__
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__FILL_ME__

# -- Encryption at rest (plugin secrets + agent LLM keys) — 64 hex chars
ENCRYPTION_KEY=__FILL_ME__

# -- Object storage (bundled MinIO)
STORAGE_ACCESS_KEY_ID=paca-minio
STORAGE_SECRET_ACCESS_KEY=__FILL_ME__

# -- ai-agent pre-shared keys. The service is scaled to 0 until the identity
#    rework (P1), but these MUST be non-empty anyway: an empty key would leave
#    the API/agent endpoints fail-open the day the service is enabled.
AGENT_API_KEY=__FILL_ME__
INTERNAL_API_KEY=__FILL_ME__

# =============================================================================
# ADR-038 P1 — Vortex identity
# NOTE: these features live in the galaxy-main patches; run Galaxy-built
# images (not vanilla upstream pins) once P1 is deployed.
# =============================================================================

# -- OIDC SSO login (Vortex). Leave OIDC_ISSUER empty to disable.
#    Register the OAuth client on the identity portal first; redirect URL
#    defaults to ${PUBLIC_URL}/api/v1/auth/oidc/callback.
# Split-horizon: identity mints id_token iss theo OIDC_ISSUER NỘI BỘ của nó
# (http://nexus-identity:8086) — RP server-side PHẢI dùng đúng URL nội bộ này
# (như RAGFlow); authorize endpoint trong discovery vẫn là URL public cho browser.
OIDC_ISSUER=http://nexus-identity:8086
OIDC_CLIENT_ID=__FILL_ME__
OIDC_CLIENT_SECRET=__FILL_ME__
#OIDC_SCOPES=openid profile email
#OIDC_AUTO_CREATE_USERS=true
#OIDC_DEFAULT_ROLE=USER
#OIDC_BUTTON_LABEL=Sign in with Vortex

# -- Trusted-issuer bearer auth (agents act as users via act_as claims).
GALAXY_TRUSTED_ISSUER=http://nexus-identity:8086

# -- Legacy X-Agent-ID header impersonation is DISABLED by default (ADR-038).
#    Only flip to "enabled" as a temporary escape hatch during migration.
#AGENT_HEADER_IMPERSONATION=disabled

# -- Force ALL ai-agent LLM traffic through the platform proxy (overrides
#    per-agent llm_base_url / API keys stored in the DB).
#    Superseded by GALAXY_AI_ROLE below — leave these unset when a role is set.
#LLM_BASE_URL_OVERRIDE=https://ai.skyplatform.net/api/identity/ai/v1
#LLM_API_KEY_OVERRIDE=__FILL_ME__

# -- ADR-038 T3: platform AI ROLE routing (preferred over the raw overrides
#    above). All LLM traffic goes to identity /ai/v1 as model=<role>; the
#    platform admin rebinds the role's model in /nexus/admin → AI Models
#    (ai_role_assignments) with no Paca redeploy. Each conversation carries a
#    short-lived RS256 act_as token naming the triggering user, so AI spend
#    is attributed per user (agent_id = the role) in ai_usage_logs.
GALAXY_AI_ROLE=paca-ai
#GALAXY_AI_PROXY_URL=http://nexus-identity:8086/ai/v1
#GALAXY_IDENTITY_URL=
# Platform INTERNAL_SERVICE_SECRET — copy AT DEPLOY TIME from the platform's
# host-side env (~/Nexus/Galaxy-Nexus/runtime/galaxy-shared/*.env). NEVER
# commit a real value; ai-agent refuses to start with GALAXY_AI_ROLE set and
# this empty (fail-closed).
GALAXY_INTERNAL_SERVICE_SECRET=__FILL_ME__
# Sandbox agent-server containers make the LLM calls themselves — they must
# join galaxy_network to reach nexus-identity (kept OUT of the primary-network
# slot so `api`/`gateway` still resolve on the stack network).
SANDBOX_EXTRA_NETWORKS=galaxy_network

# =============================================================================
# ADR-038 P3.2 — Galaxy chat dock
# =============================================================================

# -- Chat dock bundle URL advertised to the SPA on GET /api/v1/auth/config.
#    Leave empty (or comment out) to keep the dock unmounted. The portal URL
#    loads the always-fresh bundle straight from the platform edge; the
#    same-origin form `/dock.js` also works via the gateway bridge below.
GALAXY_DOCK_SRC=https://ai.skyplatform.net/dock.js

# -- Platform gateway origin behind the Caddy dock bridge: /dock.js,
#    /api/agentops* and /api/identity* stream through the Paca gateway to
#    this host over galaxy_network (same-origin → no CORS, SSE intact).
#    Origin only — no path. Default matches the platform DNS name.
#GALAXY_GATEWAY_URL=http://vortex-gateway

# =============================================================================
# ADR-038 P3.1 — notify-bridge (Paca events → Galaxy notification inbox)
# =============================================================================

# -- Master switch. The container idles (no reads, no publishes) until this
#    is "true"; alternatively park it with `--scale notify-bridge=0`.
BRIDGE_ENABLED=false

# -- Platform Redis carrying the notify.fan-out channel (galaxy_network DNS,
#    same convention as pm_service NOTIFY_REDIS_URL).
#GALAXY_NOTIFY_REDIS_URL=redis://agentops-redis:6379/0
#NOTIFY_FANOUT_CHANNEL=notify.fan-out

# -- Paca-side sources. Defaults reuse the stack's own Valkey and the main
#    DATABASE_URL credentials (the bridge opens Postgres with
#    default_transaction_read_only=on; point PACA_DATABASE_URL at a dedicated
#    read-only role if you provision one).
#PACA_VALKEY_URL=redis://valkey:6379/0
#PACA_DATABASE_URL=postgres://paca:...@postgres:5432/paca?sslmode=disable

# -- api service: allow the logical `iss=galaxy-nexus` stamped by identity's
#    mint endpoint on RS256 act_as tokens (signature still verified against
#    GALAXY_TRUSTED_ISSUER's JWKS — this only widens the iss string compare).
GALAXY_TRUSTED_ISSUER_CLAIMS=galaxy-nexus

# =============================================================================
# ADR-038 — dock-trigger (Paca events → ChatDock agent runs)
# =============================================================================

# -- Master switch. The container idles until this is "true".
DOCK_TRIGGER_ENABLED=false

# -- Paca service usernames that trigger a ChatDock agent run when a task is
#    assigned to them or they are @mentioned in a comment (comma-separated).
#    The run acts AS THE ASSIGNER/MENTIONER (their users.oidc_sub) — actors
#    who never logged in via SSO are skipped.
#DOCK_AGENT_TRIGGER_USERNAMES=galaxy-tasks-agent

# -- AgentOps backend (agentops-redis-net DNS) + identity mint (galaxy_network).
#    GALAXY_INTERNAL_SERVICE_SECRET above authenticates the mint.
#AGENTOPS_URL=http://agentops-backend:8090
#DOCK_TRIGGER_TIMEOUT_S=300

# -- Backups (host HDD)
BACKUP_DIR=/backup/paca-postgres
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 2 * * *
