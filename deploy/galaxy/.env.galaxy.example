# =============================================================================
# Galaxy production env for Galaxy-Paca
# Copy to deploy/galaxy/.env.galaxy on the prod host and fill every __FILL_ME__.
# NEVER commit the real .env.galaxy (gitignored).
# Generate secrets with: openssl rand -hex 32   (ENCRYPTION_KEY MUST be 64 hex)
# =============================================================================

ENVIRONMENT=production
TZ=Asia/Ho_Chi_Minh
LOG_LEVEL=info

# -- Pinned images — upgrade deliberately: read upstream release notes, then
#    bump all five tags together (see deploy/galaxy/README.md).
PACA_API_IMAGE=pacaai/paca-api:0.9.7
PACA_WEB_IMAGE=pacaai/paca-web:0.9.7
PACA_REALTIME_IMAGE=pacaai/paca-realtime:0.9.7
PACA_AI_AGENT_IMAGE=pacaai/paca-ai-agent:0.9.7
AGENT_SERVER_IMAGE=ghcr.io/paca-ai/paca-agent-server:0.9.7

# -- Public origin (TLS at the Cloudflare edge; Caddy serves plain HTTP)
PUBLIC_URL=https://tasks.skyplatform.net
CORS_ORIGINS=https://tasks.skyplatform.net
STORAGE_PUBLIC_URL=https://tasks.skyplatform.net/storage
SITE_ADDRESS=:80
COOKIE_SECURE=true

# -- Database
POSTGRES_DB=paca
POSTGRES_USER=paca
POSTGRES_PASSWORD=__FILL_ME__

# -- Auth
JWT_SECRET=__FILL_ME__
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__FILL_ME__

# -- Encryption at rest (plugin secrets + agent LLM keys) — 64 hex chars
ENCRYPTION_KEY=__FILL_ME__

# -- Object storage (bundled MinIO)
STORAGE_ACCESS_KEY_ID=paca-minio
STORAGE_SECRET_ACCESS_KEY=__FILL_ME__

# -- ai-agent pre-shared keys. The service is scaled to 0 until the identity
#    rework (P1), but these MUST be non-empty anyway: an empty key would leave
#    the API/agent endpoints fail-open the day the service is enabled.
AGENT_API_KEY=__FILL_ME__
INTERNAL_API_KEY=__FILL_ME__

# -- Backups (host HDD)
BACKUP_DIR=/backup/paca-postgres
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 2 * * *
