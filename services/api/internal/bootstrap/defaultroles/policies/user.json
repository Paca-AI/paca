{
  "version": "2026-10-01",
  "statements": [
    {
      "sid": "ReadUsers",
      "effect": "Allow",
      "actions": [
        "users:read"
      ],
      "resources": [
        "user",
        "user/*",
        "role",
        "role/*",
        "plugin",
        "plugin/*",
        "settings",
        "sso",
        "agent",
        "agent/*",
        "project"
      ]
    },
    {
      "sid": "ChatCollection",
      "effect": "Allow",
      "actions": [
        "channels:read",
        "channels:write",
        "messages:write"
      ],
      "resources": [
        "channel"
      ]
    },
    {
      "sid": "DirectMessages",
      "effect": "Allow",
      "actions": [
        "channels:read",
        "channels:write",
        "messages:write",
        "calls:join"
      ],
      "resources": [
        "channel/*"
      ],
      "conditions": {
        "StringEquals": {
          "channel.kind": [
            "dm"
          ],
          "channel.member_ids": [
            "${principal.id}"
          ]
        }
      }
    }
  ]
}
