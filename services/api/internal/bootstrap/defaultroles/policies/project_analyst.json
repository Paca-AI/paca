{
  "version": "2026-10-01",
  "statements": [
    {
      "sid": "ReadProject",
      "effect": "Allow",
      "actions": [
        "projects:read"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "Read",
      "effect": "Allow",
      "actions": [
        "agents:read",
        "annotations:read",
        "conversations:read",
        "docs:read",
        "files:read",
        "environments:read",
        "git:read",
        "project.members:read",
        "sprints:read",
        "tasks:read",
        "views:read",
        "workflows:read"
      ],
      "resources": [
        "project/PROJECT_ID/*"
      ]
    },
    {
      "sid": "Write",
      "effect": "Allow",
      "actions": [
        "conversations:write",
        "docs:write",
        "files:write"
      ],
      "resources": [
        "project/PROJECT_ID/*"
      ]
    },
    {
      "sid": "CreateTasks",
      "effect": "Allow",
      "actions": [
        "tasks:write"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "RefineDrafts",
      "effect": "Allow",
      "actions": [
        "tasks:write"
      ],
      "resources": [
        "project/PROJECT_ID/task/*"
      ],
      "conditions": {
        "In": {
          "task.status_category": [
            "refinement"
          ]
        }
      }
    },
    {
      "sid": "LeaveDraftsUnassigned",
      "effect": "Deny",
      "actions": [
        "tasks:write"
      ],
      "resources": [
        "project/PROJECT_ID/task/*"
      ],
      "conditions": {
        "StringLike": {
          "task.assignee_id": [
            "*"
          ]
        }
      }
    },
    {
      "sid": "LeaveDraftsUnplanned",
      "effect": "Deny",
      "actions": [
        "tasks:write"
      ],
      "resources": [
        "project/PROJECT_ID/task/*"
      ],
      "conditions": {
        "StringLike": {
          "task.sprint_id": [
            "*"
          ]
        }
      }
    },
    {
      "sid": "ReadRoles",
      "effect": "Allow",
      "actions": [
        "roles:read"
      ],
      "resources": [
        "project/PROJECT_ID/role/*"
      ]
    },
    {
      "sid": "ChatCollection",
      "effect": "Allow",
      "actions": [
        "channels:read"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "ChatPublicChannels",
      "effect": "Allow",
      "actions": [
        "channels:read"
      ],
      "resources": [
        "project/PROJECT_ID/channel/*"
      ],
      "conditions": {
        "In": {
          "channel.kind": [
            "public",
            "voice"
          ]
        }
      }
    },
    {
      "sid": "ChatPrivateChannels",
      "effect": "Allow",
      "actions": [
        "channels:read"
      ],
      "resources": [
        "project/PROJECT_ID/channel/*"
      ],
      "conditions": {
        "StringEquals": {
          "channel.kind": [
            "private"
          ],
          "channel.member_ids": [
            "${principal.id}"
          ]
        }
      }
    },
    {
      "sid": "InviteAssistants",
      "effect": "Allow",
      "actions": [
        "calls:invite_agent"
      ],
      "resources": [
        "project/PROJECT_ID",
        "project/PROJECT_ID/agent/*"
      ]
    },
    {
      "sid": "ResolveOwnProposals",
      "effect": "Allow",
      "actions": [
        "proposals:resolve"
      ],
      "resources": [
        "project/PROJECT_ID/proposal/*"
      ],
      "conditions": {
        "StringEquals": {
          "proposal.target_id": [
            "${principal.id}"
          ]
        }
      }
    }
  ]
}
