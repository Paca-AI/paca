{
  "version": "2026-10-01",
  "statements": [
    {
      "sid": "ReadProject",
      "effect": "Allow",
      "actions": [
        "projects:read"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "Work",
      "effect": "Allow",
      "actions": [
        "agents:read",
        "agents:write",
        "annotations:read",
        "annotations:resolve",
        "annotations:write",
        "conversations:read",
        "conversations:write",
        "docs:read",
        "docs:write",
        "files:read",
        "files:write",
        "environments:connect",
        "environments:read",
        "environments:write",
        "git:read",
        "git:write",
        "project.members:read",
        "sprints:read",
        "sprints:write",
        "tasks:read",
        "tasks:write",
        "views:read",
        "views:write",
        "workflows:read",
        "workflows:write"
      ],
      "resources": [
        "project/PROJECT_ID/*"
      ]
    },
    {
      "sid": "ReadRoles",
      "effect": "Allow",
      "actions": [
        "roles:read"
      ],
      "resources": [
        "project/PROJECT_ID/role/*"
      ]
    },
    {
      "sid": "ChatCollection",
      "effect": "Allow",
      "actions": [
        "channels:read",
        "channels:write"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "ChatPublicChannels",
      "effect": "Allow",
      "actions": [
        "channels:read",
        "channels:write",
        "messages:write",
        "calls:join"
      ],
      "resources": [
        "project/PROJECT_ID/channel/*"
      ],
      "conditions": {
        "In": {
          "channel.kind": [
            "public",
            "voice"
          ]
        }
      }
    },
    {
      "sid": "ChatPrivateChannels",
      "effect": "Allow",
      "actions": [
        "channels:read",
        "channels:write",
        "messages:write",
        "calls:join"
      ],
      "resources": [
        "project/PROJECT_ID/channel/*"
      ],
      "conditions": {
        "StringEquals": {
          "channel.kind": [
            "private"
          ],
          "channel.member_ids": [
            "${principal.id}"
          ]
        }
      }
    },
    {
      "sid": "InviteAssistants",
      "effect": "Allow",
      "actions": [
        "calls:invite_agent"
      ],
      "resources": [
        "project/PROJECT_ID",
        "project/PROJECT_ID/agent/*"
      ]
    },
    {
      "sid": "ResolveOwnProposals",
      "effect": "Allow",
      "actions": [
        "proposals:resolve"
      ],
      "resources": [
        "project/PROJECT_ID/proposal/*"
      ],
      "conditions": {
        "StringEquals": {
          "proposal.target_id": [
            "${principal.id}"
          ]
        }
      }
    }
  ]
}
