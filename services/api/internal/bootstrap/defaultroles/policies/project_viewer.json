{
  "version": "2026-10-01",
  "statements": [
    {
      "sid": "ReadProject",
      "effect": "Allow",
      "actions": ["projects:read"],
      "resources": ["project/PROJECT_ID"]
    },
    {
      "sid": "Read",
      "effect": "Allow",
      "actions": [
        "agents:read",
        "annotations:read",
        "conversations:read",
        "docs:read",
        "environments:read",
        "project.members:read",
        "sprints:read",
        "tasks:read",
        "views:read",
        "workflows:read"
      ],
      "resources": ["project/PROJECT_ID/*"]
    },
    {
      "sid": "ReadRoles",
      "effect": "Allow",
      "actions": ["roles:read"],
      "resources": ["project/PROJECT_ID/role/*"]
    }
  ]
}
