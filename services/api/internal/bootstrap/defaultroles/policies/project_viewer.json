{
  "version": "2026-10-01",
  "statements": [
    {
      "sid": "ReadProject",
      "effect": "Allow",
      "actions": [
        "projects:read"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "Read",
      "effect": "Allow",
      "actions": [
        "agents:read",
        "annotations:read",
        "conversations:read",
        "docs:read", "files:read",
        "environments:read",
        "project.members:read",
        "sprints:read",
        "tasks:read",
        "views:read",
        "workflows:read"
      ],
      "resources": [
        "project/PROJECT_ID/*"
      ]
    },
    {
      "sid": "ReadRoles",
      "effect": "Allow",
      "actions": [
        "roles:read"
      ],
      "resources": [
        "project/PROJECT_ID/role/*"
      ]
    },
    {
      "sid": "ChatCollection",
      "effect": "Allow",
      "actions": [
        "channels:read"
      ],
      "resources": [
        "project/PROJECT_ID"
      ]
    },
    {
      "sid": "ChatPublicChannels",
      "effect": "Allow",
      "actions": [
        "channels:read"
      ],
      "resources": [
        "project/PROJECT_ID/channel/*"
      ],
      "conditions": {
        "In": {
          "channel.kind": [
            "public",
            "voice"
          ]
        }
      }
    },
    {
      "sid": "ChatPrivateChannels",
      "effect": "Allow",
      "actions": [
        "channels:read"
      ],
      "resources": [
        "project/PROJECT_ID/channel/*"
      ],
      "conditions": {
        "StringEquals": {
          "channel.kind": [
            "private"
          ],
          "channel.member_ids": [
            "${principal.id}"
          ]
        }
      }
    }
  ]
}
