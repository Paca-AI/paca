# ----- Server ----------------------------------------------------------------
PORT=8080
ENV=development           # development | production

# ----- PostgreSQL ------------------------------------------------------------
DATABASE_URL=postgres://paca:paca@localhost:5432/paca?sslmode=disable

# ----- Valkey ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----- Cache -----------------------------------------------------------------
# TTL for each cache category.  Set to 0 to disable caching for that category.
CACHE_PROJECT_TTL=5m      # project detail + member lists
CACHE_CONFIG_TTL=10m      # task types, statuses, custom fields, roles, global roles
CACHE_SPRINT_TTL=2m       # sprints and views

# ----- JWT -------------------------------------------------------------------
JWT_SECRET=change-me-to-a-strong-random-secret-at-least-32-chars
JWT_ACCESS_TTL=15m        # access token lifetime
JWT_REFRESH_TTL=168h      # refresh token lifetime (7 days)
JWT_REFRESH_SESSION_TTL=24h  # refresh session lifetime

# ----- Cookies ---------------------------------------------------------------
COOKIE_SECURE=false

# ----- Default admin ---------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword

# Public base URL for externally reachable links/webhooks.
# Example: http://localhost in local dev, https://paca.example.com in production.
PUBLIC_URL=http://localhost

# ----- OIDC SSO (optional, single provider) ----------------------------------
# Human single sign-on via any standard OIDC IdP (Keycloak / Entra / Okta /
# Authentik / ...). OIDC is only a new authentication entry point: a
# successful login resolves to a Paca user and issues the same Paca JWT
# session; RBAC, API keys, ACP bridge tokens and agent MCP keys are
# unaffected. See docs/deployment/oidc-sso.md.
OIDC_ENABLED=false
# All three below are required when OIDC_ENABLED=true. The issuer is the
# IdP's base URL without a trailing slash, e.g. https://id.example.com/realms/company
# (Keycloak: no /protocol/openid-connect suffix). Discovery runs at startup
# and fails fast when the IdP is unreachable.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Comma-separated; "openid" is forced in when missing.
OIDC_SCOPES=openid,profile,email
# Callback URL; defaults to PUBLIC_URL + /api/v1/auth/oidc/callback.
# Must be https in production (loopback http allowed for local dev).
# OIDC_REDIRECT_URL=https://paca.example.com/api/v1/auth/oidc/callback
# Label shown on the login page's SSO button.
OIDC_DISPLAY_NAME=Single Sign-On
# JIT provisioning is always on: a first login of an unknown (issuer,
# sub) identity creates the Paca user. It is intentionally not configurable —
# provisioning is the only supported write path for external identities, so a
# "no JIT" mode would leave first logins with no way to succeed.

# Global role assigned to JIT-provisioned users. Must exist; ADMIN and
# SUPER_ADMIN are rejected — grant elevated roles manually in Paca.
OIDC_DEFAULT_ROLE=USER
# ID-token claim used as the username candidate (falls back to an
# opaque subject-derived name when missing/invalid).
OIDC_USERNAME_CLAIM=preferred_username
# Set to false for SSO-only deployments: hides the password form on the
# login page AND rejects password login server-side. Forced back to true
# when OIDC_ENABLED=false (password login would otherwise be the only —
# and disabled — entry point).
#
# Staged rollout is enforced at startup: with LOCAL_LOGIN_ENABLED=false the
# API refuses to boot until at least one ADMIN/SUPER_ADMIN user is bound to
# SSO (otherwise nobody could administer the instance). Enable SSO alongside
# local login first, promote an SSO user to admin, then disable local login.
LOCAL_LOGIN_ENABLED=true

# ----- Security --------------------------------------------------------------
# 32-byte AES key encoded as 64 lowercase hex chars. Used to encrypt
# sensitive values (for example plugin-stored tokens/secrets).
ENCRYPTION_KEY=

# ----- Storage ---------------------------------------------------------------
STORAGE_PROVIDER=minio
STORAGE_ENDPOINT=localhost:9000
STORAGE_PUBLIC_URL=http://localhost/storage
STORAGE_REGION=us-east-1
STORAGE_BUCKET=paca
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_SECRET_ACCESS_KEY=minioadmin
STORAGE_USE_SSL=false

# ----- Plugins ---------------------------------------------------------------
# local: plugin backend artifacts are read/written under PLUGINS_WASM_DIR.
# s3: backend.wasm is loaded from STORAGE_BUCKET + PLUGINS_S3_PREFIX.
PLUGINS_STORE=local
PLUGINS_WASM_DIR=./plugins/local/backend
PLUGINS_FRONTEND_DIR=./plugins/local/frontend
PLUGINS_MCP_DIR=./plugins/local/mcp
PLUGINS_S3_PREFIX=plugins
PLUGINS_MARKETPLACE_CATALOG_URL=https://raw.githubusercontent.com/Paca-AI/paca-plugins/master/catalog/plugins.json
PLUGINS_MARKETPLACE_TIMEOUT=20s
# Resource limits enforced on plugin WASM execution.
PLUGINS_MAX_CALL_DURATION=5s
PLUGINS_MAX_MEMORY_PAGES=1024
PLUGINS_MAX_REQUEST_BODY_BYTES=10485760

# Release / update check — powers the home update banner and the "What's New"
# changelog page (public GET /api/v1/version and /api/v1/releases). All
# best-effort: if the GitHub API is unreachable, the banner and page degrade
# to empty and nothing is surfaced.
# Version of the running build (e.g. a release tag). Unparseable values such as
# the default "dev" never trigger the update banner.
PACA_VERSION=dev
# Repositories checked for newer releases. Fork is optional (leave empty to
# check only upstream).
RELEASE_UPSTREAM_REPO=Paca-AI/paca
RELEASE_FORK_REPO=
# How long GitHub release responses are cached (Valkey) and the HTTP timeout
# for each GitHub request.
RELEASE_CHECK_CACHE_TTL=1h
RELEASE_CHECK_TIMEOUT=5s
